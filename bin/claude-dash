#!/usr/bin/env bash
# Read-only board of local Claude Code sessions. `--once` prints one frame.
set -uo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PRODUCER=${CLAUDE_DASH_PRODUCER:-$HERE/claude-sessions-all}
LIVE_INTERVAL=${CLAUDE_DASH_INTERVAL:-2}
IDLE_INTERVAL=${CLAUDE_DASH_IDLE_INTERVAL:-60}
INTERVAL=$LIVE_INTERVAL
PIDFILE=${CLAUDE_DASH_PIDFILE:-${XDG_RUNTIME_DIR:-/tmp}/claude-dash.pid}

term_width() {
  if [[ -n ${COLUMNS:-} ]] && ((COLUMNS > 0)); then printf '%s' "$COLUMNS"; return; fi
  tput cols 2>/dev/null || printf '80'
}

# frame WIDTH — render the current state as plain text on stdout.
frame() {
  local width=$1 data
  data=$("$PRODUCER" 2>/dev/null) || data=''
  if [[ -z $data ]]; then
    printf ' claude sessions\n\n ⚠ no data — the producer failed\n'
    return
  fi
  jq -r --argjson w "$width" '
    def age:
      if . == null then "—"
      elif . < 60000 then "\((. / 1000 | floor))s"
      elif . < 3600000 then "\((. / 60000 | floor))m"
      elif . < 86400000 then "\((. / 3600000 | floor))h"
      else "\((. / 86400000 | floor))d" end;
    # pad($n) fits a field to exactly $n columns: padded with spaces when it
    # fits, or cut with a trailing "…" when it does not, so a truncated name
    # or needs-text reads as cut off rather than merely coincidentally short.
    # $n can be <= 0 at a narrow terminal width (see $midw below); guard it
    # explicitly rather than lean on the negative-slice/null-identity
    # behavior a raw jq expression would otherwise fall into there.
    def pad($n):
      if $n <= 0 then ""
      elif length > $n then
        (if $n == 1 then "…" else .[0:($n - 1)] + "…" end)
      else . + (" " * ($n - length))
      end;
    def glyph:
      if .state == "blocked" then "!"
      elif .working then "●"
      else "○" end;
    # named status_label, not label: jq 1.7 reserves `label` as a keyword
    # (for `label $out | ... break $out`), so `def label:` is a syntax error.
    def status_label: (.state // .status);
    def row($midw):
      "  \(glyph) \(status_label | pad(8)) \(.name | pad(24)) " +
      "\(((.needs // .cwd) | pad($midw))) \(.idle_ms | age)";

    ($w - 46) as $midw
    # `.hosts` only exists on claude-sessions-all output; a plain
    # claude-sessions producer (no remotes configured) has neither `.hosts`
    # nor a `.host` field per session, so both default to a single local
    # group keyed off the top-level `.host` -- this is what keeps a
    # single-machine board identical to before.
    | (.host) as $top_host
    | (.hosts // [{host:$top_host, kind:"local", fetched_at:.generated_at, age_ms:0, status:"fresh", error:null}]) as $hostlist
    | (.sessions | map(. + {host: (.host // $top_host)})) as $sess
    | ($sess | map(select(.finished | not))) as $live
    | ($live | map(select(.state == "blocked")) | length) as $nblocked
    | ($live | map(select(.working and .state != "blocked")) | length) as $nbusy
    | ($live | map(select((.working | not) and .state != "blocked")) | length) as $nidle
    # One block per host: local first (no heading of its own -- the top
    # title already names it), then one block per remote host with its
    # status in the header. Each block keeps the INTERACTIVE/BACKGROUND
    # split and the collapsed "N finished" line, exactly like the
    # single-host board did.
    | ($hostlist | map(
        . as $hd
        | ($sess | map(select(.host == $hd.host))) as $rows
        | ($rows | map(select(.finished | not))) as $hlive
        | ($rows | map(select(.finished)))       as $hdone
        | ($hlive | map(select(.kind == "interactive"))) as $inter
        | ($hlive | map(select(.kind == "bg")))          as $bg
        | ( (if $hd.kind == "local" then [] else
               [ " " + $hd.host
                 + (if $hd.status == "unreachable" then
                      "  unreachable" + (if $hd.error then ": \($hd.error)" else "" end)
                    elif $hd.status == "stale" then
                      "  (\($hd.age_ms | age) ago)"
                    else "" end) ]
             end)
          + (if ($inter | length) > 0
             then [" INTERACTIVE"] + ($inter | map(row($midw))) + [""] else [] end)
          + (if ($bg | length) > 0
             then [" BACKGROUND"]  + ($bg    | map(row($midw))) + [""] else [] end)
          + (if ($hdone | length) > 0
             then ["   … \($hdone | length) finished (\($hdone | map(.name) | join(", ")))"]
             else [] end)
        )
      )) as $blocks
    | [ " claude sessions · \($top_host)" +
        (if .degraded then "   ⚠ degraded (CLI fallback)" else "" end) +
        (if .unreadable > 0 then "   ⚠ \(.unreadable) unreadable" else "" end),
        "   \($nbusy) busy · \($nblocked) blocked · \($nidle) idle",
        "" ]
      + ($blocks | flatten)
      + (if ($live | length) == 0 then ["   no sessions running", ""] else [] end)
      + ["", "   q close"]
      | .[]
      | .[0:$w]' <<<"$data" 2>/dev/null \
    || printf ' claude sessions\n\n ⚠ could not parse producer output\n'
}

if [[ ${1:-} == "--once" ]]; then
  frame "$(term_width)"
  exit 0
fi

# The pidfile is how the toggle finds us. Matching on the command line instead
# breaks the moment the scripts are installed outside a directory named *bin.
printf '%s' "$$" >"$PIDFILE" 2>/dev/null

cleanup() {
  # Only remove pidfile if it still contains this process's PID.
  # If another board instance has already overwritten it, leave it alone.
  local stored_pid
  stored_pid=$(cat "$PIDFILE" 2>/dev/null || printf '')
  if [[ "$stored_pid" == "$$" ]]; then
    rm -f "$PIDFILE" 2>/dev/null
  fi
  printf '\e[?25h\e[?1049l'   # cursor back, leave the alternate screen
  exit 0
}
trap cleanup EXIT INT TERM
trap 'WIDTH=$(term_width)' WINCH
# The toggle signals us when the window is hidden or shown, so a board parked
# in the scratchpad stops burning a full refresh on frames nobody can see.
# A missed signal is harmless: the board keeps refreshing at its current rate.
trap 'INTERVAL=$IDLE_INTERVAL' USR1
trap 'INTERVAL=$LIVE_INTERVAL; ticks=0' USR2   # ticks=0 forces an immediate repaint

printf '\e[?1049h\e[?25l'      # alternate screen, hide cursor
WIDTH=$(term_width)

# Wait in half-second ticks rather than one long `read -t $INTERVAL`. Verified
# on bash 5.2.37: a signal handler runs immediately but `read -t` then resumes
# with its ORIGINAL timeout, so a board napping at 60s would keep showing a
# stale frame for up to a minute after you unhide it. Short ticks make an
# interval change take effect within 0.5s. A tick that only times out costs a
# syscall return -- no fork, no jq, no repaint.
#
# `read` only blocks on a terminal. With stdin redirected it returns instantly,
# so the non-interactive path sleeps instead and drops key handling.
# Intervals are counted in half-second ticks so the arithmetic stays integer.
TICK=0.5
TICKS_PER_SECOND=2
ticks=0
while true; do
  if (( ticks <= 0 )); then
    printf '\e[H%s\e[J' "$(frame "$WIDTH")"
    ticks=$(( INTERVAL * TICKS_PER_SECOND ))
  fi
  if [[ -t 0 ]]; then
    read -rsn1 -t "$TICK" key && [[ $key == q || $key == $'\e' ]] && break
  else
    sleep "$TICK"
  fi
  ticks=$(( ticks - 1 ))
done
