#!/usr/bin/env bash
# Read-only board of local Claude Code sessions. `--once` prints one frame.
set -uo pipefail

# Resolve symlinks: these scripts are normally invoked through ~/.local/bin
# symlinks, and a sibling lookup there finds only what install.sh has linked.
# Resolving to the real directory means a stale install cannot break the
# dashboard by hiding a script that exists in the repo.
HERE=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")" && pwd)
PRODUCER=${CLAUDE_DASH_PRODUCER:-$HERE/claude-sessions-all}
LIVE_INTERVAL=${CLAUDE_DASH_INTERVAL:-2}
IDLE_INTERVAL=${CLAUDE_DASH_IDLE_INTERVAL:-60}
INTERVAL=$LIVE_INTERVAL
PIDFILE=${CLAUDE_DASH_PIDFILE:-${XDG_RUNTIME_DIR:-/tmp}/claude-dash.pid}

term_width() {
  if [[ -n ${COLUMNS:-} ]] && ((COLUMNS > 0)); then printf '%s' "$COLUMNS"; return; fi
  tput cols 2>/dev/null || printf '80'
}

# COLOR_TTY is captured once, here, before frame() is ever called. frame()'s
# output is captured via `$(frame ...)` in the refresh loop below, and inside
# that command substitution stdout is a pipe, not a terminal — a `[[ -t 1 ]]`
# check made *inside* frame() would therefore always read as "not a tty", even
# when the real terminal outside is one. Checking once here, before any such
# subshell exists, is what lets `auto` mode colour the live board and not just
# `--once`.
COLOR_TTY=0
[[ -t 1 ]] && COLOR_TTY=1

# use_color — true (exit 0) if the current frame should be coloured.
# Precedence: NO_COLOR (https://no-color.org; any non-empty value) always
# wins, even over an explicit CLAUDE_DASH_COLOR=always — the spec frames it as
# an unconditional opt-out ("should prevent the addition of ANSI color"), not
# one that defers to a tool's own colour switch. Otherwise CLAUDE_DASH_COLOR
# selects always/never/auto, where auto colours only when stdout is a
# terminal (see COLOR_TTY above).
use_color() {
  [[ -n ${NO_COLOR:-} ]] && return 1
  case ${CLAUDE_DASH_COLOR:-auto} in
    always) return 0 ;;
    never)  return 1 ;;
    *)      [[ $COLOR_TTY -eq 1 ]] ;;
  esac
}

# color_for CLASS TEXT — wrap TEXT in the SGR codes for CLASS. Colours are the
# kanagawa palette config/waybar.style.css already uses, kept in sync by eye
# (no shared source file between a CSS stylesheet and this bash script).
# Truecolor SGR (`\e[38;2;R;G;Bm`) is used throughout; foot supports it.
color_for() {
  local class=$1 text=$2
  case $class in
    A) printf '\e[38;2;255;160;102m%s\e[0m\n' "$text" ;;  # attention: surimiOrange
    W) printf '\e[38;2;126;156;216m%s\e[0m\n' "$text" ;;   # working: crystalBlue
    I) printf '\e[38;2;114;113;105m%s\e[0m\n' "$text" ;;   # idle: fujiGray
    H) printf '\e[1m%s\e[0m\n' "$text" ;;                  # host heading: bold, default fg
    E) printf '\e[38;2;232;36;36m%s\e[0m\n' "$text" ;;     # error/unreachable: samuraiRed
    D) printf '\e[2m%s\e[0m\n' "$text" ;;                  # dim: finished line, footer
    T)
      # The title line: plain except for a trailing "⚠ ..." warning clause
      # (degraded / unreadable), which gets the same red as any other error
      # text. This is the one line that mixes coloured and uncoloured spans,
      # so it is split at the first warning glyph instead of getting its own
      # single-colour class.
      if [[ $text == *"⚠"* ]]; then
        printf '%s\e[38;2;232;36;36m⚠%s\e[0m\n' "${text%%⚠*}" "${text#*⚠}"
      else
        printf '%s\n' "$text"
      fi
      ;;
    *) printf '%s\n' "$text" ;;
  esac
}

# colorize — read "CLASS<TAB>TEXT" lines from stdin (one per rendered board
# line, as jq emits them) and print either TEXT unchanged (colour off) or TEXT
# wrapped in CLASS's colour (colour on). The tab-prefixed class token exists so
# jq can keep doing ALL width/truncation math ($midw, $w, pad()) on plain
# visible text only — colour is applied here, strictly after that math, so it
# can never be counted as part of a line's width or be sliced in half by
# truncation.
colorize() {
  local use=$1 class text
  while IFS=$'\t' read -r class text; do
    if [[ $use -eq 1 ]]; then color_for "$class" "$text"; else printf '%s\n' "$text"; fi
  done
}

# frame WIDTH — render the current state as plain text (optionally coloured)
# on stdout.
frame() {
  local width=$1 data lines colour=0
  use_color && colour=1
  data=$("$PRODUCER" 2>/dev/null) || data=''
  if [[ -z $data ]]; then
    printf '-\t claude sessions\n-\t\nE\t ⚠ no data — the producer failed\n' | colorize "$colour"
    return
  fi
  lines=$(jq -r --argjson w "$width" '
    # A backwards clock step (NTP correction, suspend/resume drift) can make a
    # fetched_at/updatedAt look like it is in the future, yielding a negative
    # duration -- clamp at 0 rather than render a nonsensical "-3600s ago".
    def age:
      if . == null then "—"
      else ([., 0] | max) as $ms
      | if $ms < 60000 then "\(($ms / 1000 | floor))s"
        elif $ms < 3600000 then "\(($ms / 60000 | floor))m"
        elif $ms < 86400000 then "\(($ms / 3600000 | floor))h"
        else "\(($ms / 86400000 | floor))d" end
      end;
    # pad($n) fits a field to exactly $n columns: padded with spaces when it
    # fits, or cut with a trailing "…" when it does not, so a truncated name
    # or needs-text reads as cut off rather than merely coincidentally short.
    # $n can be <= 0 at a narrow terminal width (see $midw below); guard it
    # explicitly rather than lean on the negative-slice/null-identity
    # behavior a raw jq expression would otherwise fall into there.
    def pad($n):
      if $n <= 0 then ""
      elif length > $n then
        (if $n == 1 then "…" else .[0:($n - 1)] + "…" end)
      else . + (" " * ($n - length))
      end;
    # attention (derived once, upstream, never recomputed here from
    # .state/.status) covers `state == "blocked"` and takes the same "!"
    # glyph blocked rows always used -- plus every unrecognised status, so a
    # row like `waiting` renders as "! waiting" instead of silently sorting
    # in with the idle "○" rows.
    def glyph:
      if .attention then "!"
      elif .working then "●"
      else "○" end;
    # named status_label, not label: jq 1.7 reserves `label` as a keyword
    # (for `label $out | ... break $out`), so `def label:` is a syntax error.
    def status_label: (.state // .status);
    # rowclass mirrors glyph 1:1 (attention/working/idle), kept separate
    # because glyph is a display character and this is a colour-class token
    # meant for the bash side, never rendered itself.
    def rowclass:
      if .attention then "A"
      elif .working then "W"
      else "I" end;
    # Every emitted line is {c: CLASS, t: TEXT} from here down, not a plain
    # string: $w-truncation below runs on .t only, so a class token can never
    # be counted against a rendered width or be sliced in half by it. Colour
    # is applied by the bash side afterwards, from the "CLASS<TAB>TEXT" this
    # produces -- see colorize()/color_for() above.
    def row($midw):
      { c: rowclass,
        t: ("  \(glyph) \(status_label | pad(8)) \(.name | pad(24)) " +
            "\(((.needs // .cwd) | pad($midw))) \(.idle_ms | age)") };

    ($w - 46) as $midw
    # `.hosts` only exists on claude-sessions-all output; a plain
    # claude-sessions producer (no remotes configured) has neither `.hosts`
    # nor a `.host` field per session, so both default to a single local
    # group keyed off the top-level `.host` -- this is what keeps a
    # single-machine board identical to before.
    | (.host) as $top_host
    | (.hosts // [{host:$top_host, kind:"local", fetched_at:.generated_at, age_ms:0, status:"fresh", error:null}]) as $hostlist
    | (.sessions | map(. + {host: (.host // $top_host)})) as $sess
    | ($sess | map(select(.finished | not))) as $live
    | ($live | map(select(.attention)) | length) as $nattention
    | ($live | map(select(.working and (.attention | not))) | length) as $nworking
    | ($live | map(select((.working | not) and (.attention | not))) | length) as $nidle
    # One block per host: local first (no heading of its own -- the top
    # title already names it), then one block per remote host with its
    # status in the header. Each block keeps the INTERACTIVE/BACKGROUND
    # split and the collapsed "N finished" line, exactly like the
    # single-host board did.
    | ($hostlist | map(
        . as $hd
        | ($sess | map(select(.host == $hd.host))) as $rows
        | ($rows | map(select(.finished | not))) as $hlive
        | ($rows | map(select(.finished)))       as $hdone
        | ($hlive | map(select(.kind == "interactive"))) as $inter
        | ($hlive | map(select(.kind == "bg")))          as $bg
        | ( (if $hd.kind == "local" then [] else
               # A host heading is red ("E") when unreachable -- it IS the
               # error text for that host, not just a line that mentions one
               # -- and bold-default ("H") otherwise (fresh or stale).
               [ { c: (if $hd.status == "unreachable" then "E" else "H" end),
                   t: (" " + $hd.host
                       + (if $hd.status == "unreachable" then
                            "  unreachable" + (if $hd.error then ": \($hd.error)" else "" end)
                          elif $hd.status == "stale" then
                            "  (\($hd.age_ms | age) ago)"
                          else "" end)) } ]
             end)
          + (if ($inter | length) > 0
             then [{c:"-", t:" INTERACTIVE"}] + ($inter | map(row($midw))) + [{c:"-", t:""}] else [] end)
          + (if ($bg | length) > 0
             then [{c:"-", t:" BACKGROUND"}]  + ($bg    | map(row($midw))) + [{c:"-", t:""}] else [] end)
          + (if ($hdone | length) > 0
             then [{c:"D", t:"   … \($hdone | length) finished (\($hdone | map(.name) | join(", ")))"}]
             else [] end)
        )
      )) as $blocks
    # The title line is class "T": mostly plain, but color_for() reddens a
    # trailing "⚠ ..." warning clause (degraded / unreadable) when present --
    # see color_for() above for why that line alone is handled that way.
    | [ {c:"T", t: (" claude sessions · \($top_host)" +
          (if .degraded then "   ⚠ degraded (CLI fallback)" else "" end) +
          (if .unreadable > 0 then "   ⚠ \(.unreadable) unreadable" else "" end))},
        {c:"-", t: "   \($nworking) working · \($nattention) attention · \($nidle) idle"},
        {c:"-", t: ""} ]
      + ($blocks | flatten)
      + (if ($live | length) == 0 then [{c:"-", t:"   no sessions running"}, {c:"-", t:""}] else [] end)
      + [{c:"-", t:""}, {c:"D", t:"   q close"}]
      | .[]
      | .c + "\t" + (.t | .[0:$w])' <<<"$data" 2>/dev/null) \
    || lines=$'-\t claude sessions\n-\t\nE\t ⚠ could not parse producer output'
  printf '%s\n' "$lines" | colorize "$colour"
}

if [[ ${1:-} == "--once" ]]; then
  frame "$(term_width)"
  exit 0
fi

# The pidfile is how the toggle finds us. Matching on the command line instead
# breaks the moment the scripts are installed outside a directory named *bin.
printf '%s' "$$" >"$PIDFILE" 2>/dev/null

cleanup() {
  # Only remove pidfile if it still contains this process's PID.
  # If another board instance has already overwritten it, leave it alone.
  local stored_pid
  stored_pid=$(cat "$PIDFILE" 2>/dev/null || printf '')
  if [[ "$stored_pid" == "$$" ]]; then
    rm -f "$PIDFILE" 2>/dev/null
  fi
  printf '\e[?25h\e[?1049l'   # cursor back, leave the alternate screen
  exit 0
}
trap cleanup EXIT INT TERM
trap 'WIDTH=$(term_width)' WINCH
# The toggle signals us when the window is hidden or shown, so a board parked
# in the scratchpad stops burning a full refresh on frames nobody can see.
# A missed signal is harmless: the board keeps refreshing at its current rate.
trap 'INTERVAL=$IDLE_INTERVAL' USR1
trap 'INTERVAL=$LIVE_INTERVAL; ticks=0' USR2   # ticks=0 forces an immediate repaint

printf '\e[?1049h\e[?25l'      # alternate screen, hide cursor
WIDTH=$(term_width)

# Wait in half-second ticks rather than one long `read -t $INTERVAL`. Verified
# on bash 5.2.37: a signal handler runs immediately but `read -t` then resumes
# with its ORIGINAL timeout, so a board napping at 60s would keep showing a
# stale frame for up to a minute after you unhide it. Short ticks make an
# interval change take effect within 0.5s. A tick that only times out costs a
# syscall return -- no fork, no jq, no repaint.
#
# `read` only blocks on a terminal. With stdin redirected it returns instantly,
# so the non-interactive path sleeps instead and drops key handling.
# Intervals are counted in half-second ticks so the arithmetic stays integer.
TICK=0.5
TICKS_PER_SECOND=2
ticks=0
while true; do
  if (( ticks <= 0 )); then
    printf '\e[H%s\e[J' "$(frame "$WIDTH")"
    ticks=$(( INTERVAL * TICKS_PER_SECOND ))
  fi
  if [[ -t 0 ]]; then
    read -rsn1 -t "$TICK" key && [[ $key == q || $key == $'\e' ]] && break
  else
    sleep "$TICK"
  fi
  ticks=$(( ticks - 1 ))
done
