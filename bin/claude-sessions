#!/usr/bin/env bash
# Emit every live Claude Code session on this machine as one JSON document.
# The only component that knows Claude Code's on-disk layout.
set -uo pipefail

ROOT=${CLAUDE_DASH_ROOT:-$HOME/.claude}
SESSIONS_DIR=$ROOT/sessions
HOST=${CLAUDE_DASH_HOST:-$(uname -n)}
NOW=$(date +%s%3N)

# proc_start PID — field 22 of /proc/PID/stat, non-zero exit if the pid is gone.
# NOTE: `$(</proc/N/stat 2>/dev/null)` returns an EMPTY STRING successfully --
# the redirection defeats bash's special read-a-file form. Check readability
# first, then use the bare form, or every session looks dead.
proc_start() {
  local raw rest fields
  [[ -r /proc/$1/stat ]] || return 1
  raw=$(</proc/"$1"/stat) 2>/dev/null || return 1
  rest=${raw#*') '}          # drop "PID (comm) "; comm may contain spaces
  read -ra fields <<<"$rest"
  printf '%s' "${fields[19]}"
}

# emit DEGRADED UNREADABLE SESSIONS_JSON
emit() {
  jq -n --arg host "$HOST" --argjson now "$NOW" \
        --argjson degraded "$1" --argjson unreadable "$2" --argjson sessions "$3" \
    '{host: $host, generated_at: $now, degraded: $degraded,
      unreadable: $unreadable, sessions: $sessions}'
}

live=()
unreadable=0

if [[ -d $SESSIONS_DIR ]]; then
  shopt -s nullglob
  for file in "$SESSIONS_DIR"/*.json; do
    content=$(<"$file") 2>/dev/null || { unreadable=$((unreadable + 1)); continue; }
    if [[ ! $content =~ \"pid\":([0-9]+) ]]; then
      unreadable=$((unreadable + 1)); continue
    fi
    pid=${BASH_REMATCH[1]}
    if [[ ! $content =~ \"procStart\":\"([0-9]+)\" ]]; then
      unreadable=$((unreadable + 1)); continue
    fi
    recorded=${BASH_REMATCH[1]}
    current=$(proc_start "$pid") || continue   # process is gone
    [[ $current == "$recorded" ]] || continue  # pid was reused
    live+=("$file")
  done
  shopt -u nullglob
fi

# Session names and agent questions are LLM-authored free text. They are
# rendered into a Pango-markup tooltip and a terminal frame, so strip
# control characters and escape markup once, here, for every consumer.
# Shared between the batch and per-file jq programs below so both stay in
# sync; `record` reads $now from --argjson, bound in both invocations.
# shellcheck disable=SC2016 # single-quoted on purpose: these are jq $vars, not bash's
JQ_RECORD_DEF='
def clean:
  if . == null then null
  else gsub("[[:cntrl:]]"; "")
       | gsub("&"; "&amp;") | gsub("<"; "&lt;") | gsub(">"; "&gt;")
  end;
def record:
  { kind:    (if .kind == "bg" then "bg" else "interactive" end),
    pid:     .pid,
    name:    ((.name // "(unnamed)") | clean),
    cwd:     (.cwd // ""),
    status:  (.status // "idle"),
    working: ((.status // "idle") | . == "busy" or . == "shell"),
    state:   null,
    needs:   null,
    idle_ms: ($now - (.statusUpdatedAt // .updatedAt // $now)),
    job_id:  (.jobId // null) };
'

sessions='[]'
if ((${#live[@]})); then
  if sessions=$(jq -c -n --argjson now "$NOW" \
      "$JQ_RECORD_DEF"'[ inputs | record ]' "${live[@]}" 2>/dev/null); then
    : # common case: the whole live set parsed in one batched call
  else
    # One file in the batch was unreadable JSON, and jq has no partial-batch
    # mode -- a single bad file fails the whole call. Re-run per file instead:
    # slower, but only taken in this rare corrupt case, and it charges the
    # bad file alone to `unreadable` rather than losing every good session.
    records=()
    for file in "${live[@]}"; do
      if record=$(jq -c --argjson now "$NOW" \
          "$JQ_RECORD_DEF"'record' "$file" 2>/dev/null); then
        records+=("$record")
      else
        unreadable=$((unreadable + 1))
      fi
    done
    sessions='[]'
    ((${#records[@]})) && sessions=$(printf '%s\n' "${records[@]}" | jq -c -s '.')
  fi
fi

emit false "$unreadable" "$sessions"
